+
+describe("Kitty Unicode explicit grids", () => {
+  const cell = (row: number, col: number) =>
+    "\u{10eeee}" +
+    String.fromCodePoint([0x305, 0x30d][row]!) +
+    String.fromCodePoint([0x305, 0x30d][col]!);
+  const grid =
+    "\x1b[38;2;0;0;42m" +
+    cell(0, 0) +
+    cell(0, 1) +
+    "\r\n" +
+    cell(1, 0) +
+    cell(1, 1) +
+    "\x1b[0m";
+  const image =
+    "\x1b_Ga=t,f=24,s=1,v=1,i=42;" +
+    Buffer.from([255, 0, 0]).toString("base64") +
+    "\x1b\\";
+  const place = "\x1b_Ga=p,i=42,U=1,c=2,r=2\x1b\\";
+  it("renders a native-style chunked stream as one continuous grid, not glyphs", async () => {
+    const core = await newCore();
+    for (const byte of new TextEncoder().encode(image + place + grid))
+      core.writeRaw(new Uint8Array([byte]));
+    const state = core.getGraphicsState()!;
+    expect(state.placements).toHaveLength(1);
+    expect(state.placements[0]).toMatchObject({
+      imageId: 42,
+      row: 0,
+      col: 0,
+      columns: 2,
+      rows: 2,
+      virtual: { col: 0, row: 0, columns: 2, rows: 2 },
+    });
+    expect(core.getCell(0, 0).char).toBe(32);
+    expect(core.getCell(0, 0).chars).toBeFalsy();
+    state.placements[0]!.virtual!.rows = 1000;
+    expect(core.getGraphicsState()!.placements[0]!.virtual!.rows).toBe(2);
+    core.dispose();
+  });
+  it("tracks overwritten cells, scrollback, alternate screens and deletion", async () => {
+    const core = await newCore();
+    core.writeString(image + place + grid);
+    const generation = core.getGraphicsState()!.generation;
+    core.writeString("\x1b[1;1HX");
+    const split = core.getGraphicsState()!;
+    expect(split.generation).not.toBe(generation);
+    expect(split.placements).toHaveLength(2);
+    expect(split.placements[0]).toMatchObject({
+      col: 1,
+      columns: 1,
+      virtual: { col: 1, row: 0 },
+    });
+    core.writeString("\x1b[4;1H\r\n\r\n");
+    expect(core.getGraphicsState()!.placements).toHaveLength(2);
+    core.writeString("\x1b[?1049h");
+    expect(core.getGraphicsState()!.placements).toHaveLength(0);
+    core.writeString("\x1b[?1049l");
+    expect(core.getGraphicsState()!.placements).toHaveLength(2);
+    core.writeString("\x1b_Ga=d,d=I,i=42\x1b\\");
+    expect(core.getGraphicsState()!.placements).toHaveLength(0);
+    core.dispose();
+  });
+});
+
+it("retains dense native-style Unicode grids across shrink/grow/shrink reflow", async () => {
+  const core = await newCore();
+  core.resize(121, 51);
+  const marks = [
+    0x305, 0x30d, 0x30e, 0x310, 0x312, 0x33d, 0x33e, 0x33f, 0x346, 0x34a, 0x34b,
+    0x34c, 0x350, 0x351, 0x352, 0x357, 0x35b, 0x363, 0x364, 0x365, 0x366, 0x367,
+    0x368, 0x369, 0x36a, 0x36b,
+  ];
+  for (const id of [42, 43]) {
+    core.writeString(
+      `\x1b_Ga=t,f=24,s=1,v=1,i=${id};/wAA\x1b\\\x1b_Ga=p,i=${id},U=1,c=26,r=13\x1b\\\x1b[38;2;0;0;${id}m`,
+    );
+    for (let row = 0; row < 13; row++)
+      core.writeString(
+        marks
+          .map(
+            (mark, col) =>
+              "\u{10eeee}" + String.fromCodePoint(marks[row]!, mark),
+          )
+          .join("") + "\r\n",
+      );
+    core.writeString("\x1b[0mSaved\r\n");
+  }
+  for (const [cols, rows] of [
+    [89, 44],
+    [92, 44],
+    [89, 44],
+    [41, 8],
+    [121, 51],
+  ]) {
+    core.resize(cols!, rows!);
+    expect(core.getGraphicsState()!.placements).toHaveLength(2);
+    for (let y = 0; y < rows!; y++)
+      for (let x = 0; x < cols!; x++)
+        expect(core.getCell(y, x).char).toBeLessThanOrEqual(0x10ffff);
+  }
+  core.dispose();
+});
