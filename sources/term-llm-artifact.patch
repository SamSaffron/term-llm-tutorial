new file mode 100644
index 00000000..24a94ebb
--- /dev/null
+++ b/internal/tools/browser_workspace.go
@@ -0,0 +1,25 @@
+package tools
+
+import (
+	"os"
+	"path/filepath"
+)
+
+// publishBrowserWorkspace is an opt-in guest-only preview mailbox. It exposes no
+// command execution and does not change the CLI process working directory.
+func publishBrowserWorkspace(dir string) {
+	path := os.Getenv("TERM_LLM_BROWSER_WORKSPACE_FILE")
+	if path == "" {
+		return
+	}
+	f, err := os.CreateTemp(filepath.Dir(path), ".workspace-")
+	if err != nil {
+		return
+	}
+	defer os.Remove(f.Name())
+	_, err = f.WriteString(dir)
+	closeErr := f.Close()
+	if err == nil && closeErr == nil {
+		_ = os.Rename(f.Name(), path)
+	}
+}
diff --git a/internal/tools/browser_workspace_test.go b/internal/tools/browser_workspace_test.go
new file mode 100644
index 00000000..cc9bc74d
--- /dev/null
+++ b/internal/tools/browser_workspace_test.go
@@ -0,0 +1,24 @@
+package tools
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestBrowserWorkspaceMailbox(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "active-cwd")
+	t.Setenv("TERM_LLM_BROWSER_WORKSPACE_FILE", path)
+	publishBrowserWorkspace(dir)
+	raw, err := os.ReadFile(path)
+	if err != nil || string(raw) != dir {
+		t.Fatalf("mailbox %q: %v", raw, err)
+	}
+	t.Setenv("TERM_LLM_BROWSER_WORKSPACE_FILE", "")
+	publishBrowserWorkspace("/unrelated")
+	raw, _ = os.ReadFile(path)
+	if string(raw) != dir {
+		t.Fatal("wrote disabled mailbox")
+	}
+}
