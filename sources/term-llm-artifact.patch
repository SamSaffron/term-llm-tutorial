+		t.Fatal(err)
+	}
+	engine := llm.NewEngine(nil, nil)
+	manager, err := settings.SetupToolManager(&config.Config{}, engine)
+	if err != nil || manager == nil {
+		t.Fatalf("custom-only manager: %v", err)
+	}
+	specs := engine.Tools().AllSpecs()
+	if len(specs) != 1 || specs[0].Name != "write_artifact" {
+		t.Fatalf("unexpected tool surface: %+v", specs)
+	}
+	if !engine.Tools().IsFinishingTool("write_artifact") {
+		t.Fatal("lost finishing interface")
+	}
