+func TestCustomOnlyFinishingToolManager(t *testing.T) {
+	dir := t.TempDir()
+	settings := SessionSettings{AgentDir: dir, CustomTools: []agents.CustomToolDef{{Name: "write_artifact", Script: "write-artifact", Finish: true}}}
